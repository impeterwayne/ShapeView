<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shadowRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".ShadowActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="32dp">

        <!-- Title / Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:text="@string/title_shadows"
            android:textColor="#111827"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Section: Shadow Effects -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:text="@string/section_shadow_effects"
            android:textColor="#374151"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Outer Shadow -->
        <com.genesys.shape.view.ShapeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingVertical="22dp"
            android:text="@string/shadow_outer_card"
            android:textColor="#1F2937"
            android:textSize="14sp"
            android:textStyle="bold"
            app:shape_effect1Blur="12dp"
            app:shape_effect1Color="#30000000"
            app:shape_effect1OffsetY="4dp"
            app:shape_radius="16dp"
            app:shape_ripple_color="#18000000"
            app:shape_ripple_enabled="true"
            app:shape_solidColor="#FFFFFF" />

        <!-- Hard Shadow (Neo-Brutalist) -->
        <com.genesys.shape.layout.ShapeLinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:padding="18dp"
            app:shape_effect1Blur="0dp"
            app:shape_effect1Color="#FF000000"
            app:shape_effect1OffsetX="6dp"
            app:shape_effect1OffsetY="6dp"
            app:shape_radius="14dp"
            app:shape_ripple_color="#26000000"
            app:shape_ripple_enabled="true"
            app:shape_solidColor="#FEF08A"
            app:shape_strokeColor="#000000"
            app:shape_strokeSize="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/shadow_hard_card"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/shadow_hard_card_desc"
                android:textColor="#713F12"
                android:textSize="12sp" />

        </com.genesys.shape.layout.ShapeLinearLayout>

        <!-- Inner Shadow -->
        <com.genesys.shape.view.ShapeTextView
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/shadow_inner_card"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:shape_effect1Blur="8dp"
            app:shape_effect1Color="#80000000"
            app:shape_effect1OffsetX="3dp"
            app:shape_effect1OffsetY="3dp"
            app:shape_effect1Type="innerShadow"
            app:shape_radius="16dp"
            app:shape_ripple_color="#20FFFFFF"
            app:shape_ripple_enabled="true"
            app:shape_solidColor="#374151" />

        <!-- Spread Rim -->
        <com.genesys.shape.view.ShapeTextView
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/shadow_spread_rim"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:shape_effect1Blur="10dp"
            app:shape_effect1Color="#80000000"
            app:shape_effect1Spread="4dp"
            app:shape_effect1Type="innerShadow"
            app:shape_radius="16dp"
            app:shape_ripple_color="#20FFFFFF"
            app:shape_ripple_enabled="true"
            app:shape_solidColor="#374151" />

        <!-- Bevel Effect -->
        <com.genesys.shape.view.ShapeTextView
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/shadow_bevel"
            android:textColor="#D1D5DB"
            android:textSize="14sp"
            android:textStyle="bold"
            app:shape_effect1Blur="6dp"
            app:shape_effect1Color="#70000000"
            app:shape_effect1OffsetX="3dp"
            app:shape_effect1OffsetY="3dp"
            app:shape_effect1Type="innerShadow"
            app:shape_effect2Blur="6dp"
            app:shape_effect2Color="#40FFFFFF"
            app:shape_effect2OffsetX="-3dp"
            app:shape_effect2OffsetY="-3dp"
            app:shape_effect2Type="innerShadow"
            app:shape_radius="16dp"
            app:shape_ripple_color="#20FFFFFF"
            app:shape_ripple_enabled="true"
            app:shape_solidColor="#4B5563" />

        <!-- Two Drop Shadows (Elevation Ramp) -->
        <com.genesys.shape.view.ShapeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:paddingVertical="22dp"
            android:text="@string/shadow_elevation_ramp"
            android:textColor="#1F2937"
            android:textSize="14sp"
            android:textStyle="bold"
            app:shape_effect1Blur="4dp"
            app:shape_effect1Color="#26000000"
            app:shape_effect1OffsetY="2dp"
            app:shape_effect2Blur="24dp"
            app:shape_effect2Color="#1F000000"
            app:shape_effect2OffsetY="12dp"
            app:shape_radius="16dp"
            app:shape_ripple_color="#18000000"
            app:shape_ripple_enabled="true"
            app:shape_solidColor="#FFFFFF" />

        <!-- Drop + Inner combo -->
        <com.genesys.shape.view.ShapeTextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:paddingVertical="22dp"
            android:text="@string/shadow_drop_inner_combo"
            android:textColor="#F9FAFB"
            android:textSize="14sp"
            android:textStyle="bold"
            app:shape_effect1Blur="14dp"
            app:shape_effect1Color="#40000000"
            app:shape_effect1OffsetY="6dp"
            app:shape_effect2Blur="10dp"
            app:shape_effect2Color="#99000000"
            app:shape_effect2OffsetY="4dp"
            app:shape_effect2Type="innerShadow"
            app:shape_radius="16dp"
            app:shape_ripple_color="#20FFFFFF"
            app:shape_ripple_enabled="true"
            app:shape_solidColor="#4F46E5" />

        <!-- Link to Shadow Geometry Screen -->
        <com.genesys.shape.view.ShapeButton
            android:id="@+id/btnOpenGeometry"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/btn_open_shadow_geometry"
            android:textColor="#4338CA"
            android:textSize="14sp"
            android:textStyle="bold"
            app:shape_radius="14dp"
            app:shape_solidColor="#EEF2FF"
            app:shape_solidPressedColor="#E0E7FF"
            app:shape_strokeColor="#C7D2FE"
            app:shape_strokeSize="1.5dp" />

    </LinearLayout>
</ScrollView>
