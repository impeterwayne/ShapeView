<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="32dp">

        <!-- Header Pill Badge -->
        <com.genesys.shape.view.ShapeTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:text="@string/app_name"
            android:textColor="#4338CA"
            android:textSize="12sp"
            android:textStyle="bold"
            app:shape_radius="12dp"
            app:shape_solidColor="#EEF2FF" />

        <!-- Title & Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/hub_title"
            android:textColor="#0F172A"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:text="@string/hub_subtitle"
            android:textColor="#64748B"
            android:textSize="14sp" />

        <!-- Menu Item 1: Buttons & Inputs -->
        <com.genesys.shape.layout.ShapeLinearLayout
            android:id="@+id/cardButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            app:shape_effect1Blur="10dp"
            app:shape_effect1Color="#1A000000"
            app:shape_effect1OffsetY="3dp"
            app:shape_radius="16dp"
            app:shape_ripple_color="#206366F1"
            app:shape_ripple_enabled="true"
            app:shape_solidColor="#FFFFFF"
            app:shape_strokeColor="#E2E8F0"
            app:shape_strokeSize="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_buttons_title"
                android:textColor="#1E293B"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/menu_buttons_desc"
                android:textColor="#64748B"
                android:textSize="13sp" />

        </com.genesys.shape.layout.ShapeLinearLayout>

        <!-- Menu Item 2: Cards & Shadows -->
        <com.genesys.shape.layout.ShapeLinearLayout
            android:id="@+id/cardShadows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="18dp"
            app:shape_effect1Blur="10dp"
            app:shape_effect1Color="#1A000000"
            app:shape_effect1OffsetY="3dp"
            app:shape_radius="16dp"
            app:shape_ripple_color="#206366F1"
            app:shape_ripple_enabled="true"
            app:shape_solidColor="#FFFFFF"
            app:shape_strokeColor="#E2E8F0"
            app:shape_strokeSize="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_shadows_title"
                android:textColor="#1E293B"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/menu_shadows_desc"
                android:textColor="#64748B"
                android:textSize="13sp" />

        </com.genesys.shape.layout.ShapeLinearLayout>

        <!-- Menu Item 3: Shadow Geometry -->
        <com.genesys.shape.layout.ShapeLinearLayout
            android:id="@+id/cardShadowGeometry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="18dp"
            app:shape_effect1Blur="10dp"
            app:shape_effect1Color="#1A000000"
            app:shape_effect1OffsetY="3dp"
            app:shape_radius="16dp"
            app:shape_ripple_color="#206366F1"
            app:shape_ripple_enabled="true"
            app:shape_solidColor="#FFFFFF"
            app:shape_strokeColor="#E2E8F0"
            app:shape_strokeSize="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_shadow_geometry_title"
                android:textColor="#1E293B"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/menu_shadow_geometry_desc"
                android:textColor="#64748B"
                android:textSize="13sp" />

        </com.genesys.shape.layout.ShapeLinearLayout>

        <!-- Menu Item 4: Gradients & Borders -->
        <com.genesys.shape.layout.ShapeLinearLayout
            android:id="@+id/cardGradients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="18dp"
            app:shape_effect1Blur="10dp"
            app:shape_effect1Color="#1A000000"
            app:shape_effect1OffsetY="3dp"
            app:shape_radius="16dp"
            app:shape_ripple_color="#206366F1"
            app:shape_ripple_enabled="true"
            app:shape_solidColor="#FFFFFF"
            app:shape_strokeColor="#E2E8F0"
            app:shape_strokeSize="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_gradients_title"
                android:textColor="#1E293B"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/menu_gradients_desc"
                android:textColor="#64748B"
                android:textSize="13sp" />

        </com.genesys.shape.layout.ShapeLinearLayout>

        <!-- Menu Item 4: Media & Typography -->
        <com.genesys.shape.layout.ShapeLinearLayout
            android:id="@+id/cardMedia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="18dp"
            app:shape_effect1Blur="10dp"
            app:shape_effect1Color="#1A000000"
            app:shape_effect1OffsetY="3dp"
            app:shape_radius="16dp"
            app:shape_ripple_color="#206366F1"
            app:shape_ripple_enabled="true"
            app:shape_solidColor="#FFFFFF"
            app:shape_strokeColor="#E2E8F0"
            app:shape_strokeSize="1dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/menu_media_title"
                android:textColor="#1E293B"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/menu_media_desc"
                android:textColor="#64748B"
                android:textSize="13sp" />

        </com.genesys.shape.layout.ShapeLinearLayout>

    </LinearLayout>
</ScrollView>